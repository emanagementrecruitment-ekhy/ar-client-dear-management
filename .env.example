DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"
CLIENT_PORTAL_ADMIN_PASSWORD="replace-with-a-strong-password"

# Second, narrower gate on top of the shared admin password above — required
# for the most sensitive actions (editing a ledger entry's VCR/Fee, renaming
# or deleting a Channel/Client account). Any staff member can log into
# /admin, but only whoever holds this code can actually perform those
# actions. Keep it separate from CLIENT_PORTAL_ADMIN_PASSWORD and share it
# only with the Owner.
OWNER_ACTION_CODE="replace-with-an-owner-only-code"

# Optional real OTP delivery for Client login — same providers as the main
# AR Corp app (src/lib/otp-providers.ts), configured independently here since
# this is a separate deployment. Leave unset to fall back to a console-logged
# / on-screen dev code (non-production only).
# BREVO_API_KEY=
# SMTP_FROM=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# FONNTE_TOKEN=
